{
  "include": ["./src/**/*"],
  "exclude": ["*/node_modules/**/*", "**/*.test.ts"],
  "compilerOptions": {
    "types": ["bun", "node"],
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationMap": true,
    "verbatimModuleSyntax": false,
    "noUnusedParameters": true
  }
}
